# Kopieer naar .env.local en vul in. Nooit committen!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Publishable key (sb_publishable_…) of oude anon key
SUPABASE_SERVICE_ROLE_KEY=       # Secret key — pas nodig vanaf fase 3, nooit delen

# Tijdelijke testmodus: zolang dit is ingevuld log je in met dit ene
# teamwachtwoord i.p.v. een inlogmail (dan is SUPABASE_SERVICE_ROLE_KEY
# verplicht). Leeg laten = gewone login met inlogmail.
SITE_PASSWORD=

# Unipile (staat in je Unipile-dashboard)
UNIPILE_DSN=            # bijv. https://apiXX.unipile.com:XXXXX
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=     # id van je gekoppelde LinkedIn-account
UNIPILE_LINKEDIN_API=classic   # classic | sales_navigator | recruiter
UNIPILE_WEBHOOK_SECRET=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# E-mail
RESEND_API_KEY=
EMAIL_FROM=Werkplaats@cr8las.nl

# Cron-beveiliging
CRON_SECRET=
